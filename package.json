{
  "name": "lucifer-gate",
  "version": "0.1.0-alpha.1",
  "description": "AI agent command firewall with Telegram-based human approval",
  "type": "module",
  "bin": {
    "lucifer-gate": "dist/server/cli.js"
  },
  "files": [
    "dist/server/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "ai-agent",
    "firewall",
    "telegram",
    "command-proxy",
    "human-in-the-loop",
    "approval"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/alkampfergit/lucifer.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsx watch server/src/index.ts",
    "build:server": "tsc -p tsconfig.server.json && npm run build:assets",
    "build:assets": "node scripts/copy-assets.mjs",
    "build": "npm run clean && npm run check:structure && npm run build:server",
    "start": "node dist/server/index.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:structure": "node scripts/check-dependencies.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "http-proxy-middleware": "^3.0.5",
    "pino": "^10.3.1",
    "telegraf": "^4.16.3"
  },
  "overrides": {
    "telegram-test-api": {
      "axios": "^1.14.0",
      "body-parser": "^1.20.3",
      "cookie": "^0.7.0",
      "express": "^4.21.2",
      "qs": "^6.14.2",
      "send": "^0.19.0",
      "serve-static": "^1.16.0"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "telegram-test-api": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
